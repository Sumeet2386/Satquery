# SatQuery AI — Environment Configuration
# Copy this to .env and fill in your values. Never commit .env to git.

# --- Application ---
APP_ENV=development
APP_NAME=SatQuery AI
APP_VERSION=0.1.0
APP_SECRET_KEY=change-this-to-a-long-random-secret-in-production
DEBUG=true

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://satquery:satquery_dev@localhost:5432/satquery_db
DATABASE_URL_SYNC=postgresql://satquery:satquery_dev@localhost:5432/satquery_db

# --- File Storage (S3-compatible) ---
# For local dev use MinIO; for production use AWS S3 or compatible
STORAGE_BACKEND=local                         # local | s3 | minio
STORAGE_LOCAL_DIR=./storage/uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=satquery-uploads
S3_REGION=us-east-1

# --- Auth ---
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI / LLM ---
# Used for natural-language explanation of results
# Set one of the following (or both for fallback)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
EXPLANATION_MODEL=gpt-4o                     # gpt-4o | claude-3-5-sonnet | none

# --- Model Inference ---
MODEL_REGISTRY_PATH=./ml/registry/models.json
DEFAULT_CHANGE_DETECTION_MODEL=changeformer  # changeformer | bit | snunet
INFERENCE_DEVICE=cpu                          # cpu | cuda | mps
MODEL_CACHE_DIR=./ml/model_cache
MAX_INFERENCE_WORKERS=2

# --- Image Validation ---
MAX_UPLOAD_SIZE_MB=500
SUPPORTED_FORMATS=tif,tiff,jp2
MAX_RESOLUTION_RATIO=4.0                     # max allowed resolution ratio between image pairs
MIN_OVERLAP_RATIO=0.8                        # minimum spatial overlap between image pairs

# --- Job Queue ---
MAX_CONCURRENT_JOBS=5
JOB_TIMEOUT_SECONDS=600

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json                               # json | text
