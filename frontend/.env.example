# SatQuery AI — Frontend Environment Variables (Vercel)
# ==============================================================================

# Backend API Configuration
# Optional: URL of deployed FastAPI backend (e.g. Railway, Render, Fly.io, or AWS)
# If omitted or offline, SatQuery AI automatically operates in offline/client-side mode.
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
NEXT_PUBLIC_APP_NAME=SatQuery AI
NEXT_PUBLIC_APP_VERSION=0.1.0

# Optional Server-side LLM Keys for Vercel Serverless Function (/api/agent)
# Setting these allows visitors to query the AI agent without entering personal keys in settings.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
